{
  "apiVersion": 3,
  "name": "ficus/review",
  "title": "Review",
  "category": "widgets",
  "icon": "star-filled",
  "description": "Singola card recensione con nome, testo, rating e avatar.",
  "parent": ["ficus/reviews-carousel"],
  "supports": {
    "html": false,
    "reusable": false
  },
  "attributes": {
    "avatar": {
      "type": "object",
      "default": {
        "id": 0,
        "url": "",
        "alt": ""
      }
    },
    "reviewerName": {
      "type": "string",
      "default": ""
    },
    "reviewText": {
      "type": "string",
      "default": ""
    },
    "rating": {
      "type": "number",
      "default": 5
    }
  }
}